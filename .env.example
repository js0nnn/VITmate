# Copy to .env and adjust. All variables are optional.

# "development" enables the interactive API docs at /docs; use "production" when hosting.
VITMATE_ENV=development

# Paths are relative to the project root unless absolute.
VITMATE_MODEL_DIR=backend/trained_model
VITMATE_KNOWLEDGE_FILE=data/knowledge/vit_knowledge.yaml
VITMATE_FRONTEND_DIST=frontend/dist

# Predictions below this confidence get a "please rephrase" reply (0-1).
# 0.35 was selected on the validation set (see docs/results/evaluation.md).
VITMATE_CONFIDENCE_THRESHOLD=0.35

# Browser origins allowed to call the API (JSON list).
VITMATE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Maximum characters per message.
VITMATE_MAX_MESSAGE_LENGTH=500

# Optional: limit PyTorch CPU threads on small hosts.
# VITMATE_TORCH_THREADS=2

VITMATE_LOG_LEVEL=INFO
